{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sdt.invalid/schemas/material-package-1.1.json",
  "title": "SDT portable learning material package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "target", "artifacts", "exclusions"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "target": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/artifact" }
    },
    "exclusions": {
      "type": "array",
      "items": { "$ref": "#/definitions/exclusion" }
    }
  },
  "definitions": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path", "sha256", "privacy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*\\\\).+$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "privacy": { "enum": ["none", "personal", "real"] },
        "privacy_clearance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "basis"],
          "properties": {
            "status": { "const": "cleared" },
            "basis": { "type": "string", "minLength": 1 }
          }
        },
        "source_versions": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "privacy": { "enum": ["personal", "real"] } }, "required": ["privacy"] },
          "then": { "required": ["privacy_clearance"] }
        },
        {
          "if": { "properties": { "privacy": { "const": "none" } }, "required": ["privacy"] },
          "then": { "not": { "required": ["privacy_clearance"] } }
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
